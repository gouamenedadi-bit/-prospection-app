generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Stockiste {
  id                    Int         @id @default(autoincrement())
  name                  String
  phone                 String
  email                 String      @unique
  password              String
  city                  String
  commune               String
  neighborhood          String?
  latitude              Float?
  longitude             Float?
  subscriptionExpiresAt DateTime

  formations   Formation[]
  inventories  Inventory[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Partenaire {
  id                    Int      @id @default(autoincrement())
  firstName             String
  lastName              String
  phone                 String
  email                 String   @unique
  password              String
  sponsorCode           String?
  city                  String
  commune               String
  subscriptionExpiresAt DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id             Int      @id @default(autoincrement())
  accountType    String   // "stockiste" | "partenaire"
  accountId      Int
  planLabel      String
  durationDays   Int
  amount         Float
  method         String?
  provider       String   @default("cinetpay")
  status         String   @default("pending") // pending | success | failed
  transactionRef String?  @unique
  validatedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Avis {
  id          Int      @id @default(autoincrement())
  accountType String   // "stockiste" | "partenaire"
  accountId   Int
  rating      Int
  comment     String?

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  accountType String    // "stockiste" | "partenaire"
  accountId   Int
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?

  createdAt DateTime @default(now())
}

model Produit {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  partnerPrice Float
  publicPrice  Float
  image        String?
  posology     String?
  pv           Float?
  inventories  Inventory[]

  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Formation {
  id          Int       @id @default(autoincrement())
  title       String
  date        DateTime
  time        String
  trainer     String
  image       String?
  
  stockisteId Int
  stockiste   Stockiste @relation(fields: [stockisteId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Inventory {
  id          Int       @id @default(autoincrement())
  quantity    Int       @default(0)
  
  stockisteId Int
  produitId   Int
  
  stockiste   Stockiste @relation(fields: [stockisteId], references: [id], onDelete: Cascade)
  produit     Produit   @relation(fields: [produitId], references: [id], onDelete: Cascade)
  
  @@unique([stockisteId, produitId])
}
